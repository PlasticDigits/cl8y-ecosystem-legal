# Database (local PostgreSQL — see README)
DATABASE_URL=postgres://cl8y_legal:cl8y_legal@localhost:5432/cl8y_legal

# API (deploy at https://api.terms.cl8y.com)
LISTEN_ADDR=0.0.0.0:8080

# Web app URL — used for sign links in API responses (https://terms.cl8y.com)
LEGAL_PUBLIC_BASE_URL=https://terms.cl8y.com

# Terms source (GitLab raw file on main)
TERMS_GITLAB_RAW_URL=https://gitlab.com/PlasticDigits/cl8y-ecosystem-legal/-/raw/main/TERMS_AND_CONDITIONS.txt
TERMS_SYNC_INTERVAL_HOURS=4
TERMS_SYNC_ON_STARTUP=true

# Optional: serve web/dist from this process (local all-in-one only; production uses separate hosts)
# STATIC_DIR=./web/dist

# Secrets
# Required. API refuses to start if unset/empty, or if set to the known insecure
# default `dev-admin-token`, unless ALLOW_INSECURE_DEFAULTS=true (local only).
ADMIN_TOKEN=change-me-admin-token
# Local-only escape hatch (never enable in production):
# ALLOW_INSECURE_DEFAULTS=true
# Same token for @cl8ytermsbot (legal API widget/WebApp + enforcement bot).
# Same token for API Telegram sign-in and cl8ytermsbot (bot/.env.example).
TELEGRAM_BOT_TOKEN=

# Enforcement bot only — see bot/.env.example (ALLOWED_CHAT_IDS, etc.).

# Rate limits (requests per minute per IP; authenticated /update_terms is 1 per second per IP)
RATE_LIMIT_READ=60
RATE_LIMIT_WRITE=10

# Client IP / X-Forwarded-For
# Default: use TCP peer only (spoofed XFF ignored).
# When the peer is inside one of these CIDRs, honor XFF using the **rightmost** valid hop
# (proxies that append the observed client IP put the trustworthy address last).
# Example behind a local reverse proxy: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=

# CORS (comma-separated origins; add dapp origins that call the API from the browser)
CORS_ORIGINS=https://terms.cl8y.com
# Local dev example:
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# LEGAL_PUBLIC_BASE_URL=http://localhost:8080

# Allow localhost as property in development
ALLOW_LOCALHOST_PROPERTY=true
