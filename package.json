{
  "name": "cl8y-ecosystem-legal",
  "private": true,
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "build:sdk": "npm run build -w @plasticdigits/cl8y-clickwrap",
    "test:sdk": "npm run test -w @plasticdigits/cl8y-clickwrap",
