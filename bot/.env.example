# Same bot token as the legal API (Telegram Login / WebApp verification).
TELEGRAM_BOT_TOKEN=

# Public groups by @username (resolved at startup; bot must already be a member).
ALLOWED_CHAT_USERNAMES=ceramicliberty,yieldomega,CZodiacofficial,dogegod_token,GreenMinerr,wojakprison

# Private invite groups (e.g. t.me/+5Fo7XSQc2ChkNzll): add the bot, send /chatid in the group, paste id here.
ALLOWED_CHAT_IDS=

# Button labels in DM /start menu (key:label, key is username or numeric chat id).
CHAT_LABELS=ceramicliberty:ceramicliberty,yieldomega:yieldomega,CZodiacofficial:CZodiacofficial,dogegod_token:dogegod_token,GreenMinerr:GreenMinerr,wojakprison:wojakprison

# Legal API + signing UI (production defaults).
LEGAL_API_BASE_URL=https://api.terms.cl8y.com/api/v1
LEGAL_PUBLIC_BASE_URL=https://terms.cl8y.com

# Shared Postgres (bot tables created by api migrations).
DATABASE_URL=postgres://cl8y_legal:cl8y_legal@localhost:5432/cl8y_legal

# Post signing instructions 4× per day (every 6 hours).
REMINDER_INTERVAL_HOURS=6

# Remove members who have not signed latest terms within this window.
GRACE_PERIOD_DAYS=30

# How often to check for newly published terms (minutes).
TERMS_POLL_INTERVAL_MINUTES=15

# How often to scan for members past the grace period (minutes).
ENFORCEMENT_INTERVAL_MINUTES=60
