# Production API host
VITE_API_BASE_URL=https://api.terms.cl8y.com

# Local dev (Vite proxies /api to localhost:8080):
# VITE_API_BASE_URL=

# Production: cl8ytermsbot
VITE_TELEGRAM_BOT_NAME=cl8ytermsbot

# Post-accept redirect_uri allowlist (exact origins, comma-separated).
# Portal never navigates to non-allowlisted URIs (success UI still shows).
# Production example:
# VITE_REDIRECT_URI_ALLOWLIST=https://dex.cl8y.com,https://bridge.cl8y.com,https://yieldomega.com
VITE_REDIRECT_URI_ALLOWLIST=

# Permit http://localhost / 127.0.0.1 / ::1 redirect_uri (local + Playwright e2e)
# VITE_ALLOW_LOCALHOST_REDIRECT=true

# WalletConnect Cloud project id for *this* Legal portal (Galaxy Station WC v2 + EVM WC).
# Must be Legal-owned — do not copy ustr-cmm / DEX integrator ids into git.
# LUNC Dash WC v1 uses the public LUNC Dash bridge and does not need this.
# When unset, EVM still offers Open in MetaMask / Binance Web3 / Copy link.
# VITE_WC_PROJECT_ID=
